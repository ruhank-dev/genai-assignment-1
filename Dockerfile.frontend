# --- Stage 1: build the React app ---
FROM node:22-alpine AS builder
RUN npm install -g pnpm@12.8.1
WORKDIR /web
COPY src/app/frontend/package.json src/app/frontend/pnpm-lock.yaml src/app/frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY src/app/frontend/ ./
RUN pnpm build

# --- Stage 2: static files behind nginx (also reverse-proxies /api and /health to the backend) ---
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /web/dist /usr/share/nginx/html
EXPOSE 80
